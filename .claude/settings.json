{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "2",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh *)",
      "Bash(./scripts/build.sh *)",
      "Bash(./scripts/test.sh *)",
      "Bash(./scripts/run.sh *)",
      "Bash(./scripts/measure.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pgrep *)",
      "Bash(pkill -x Aash)",
      "Edit(/Sources/**)",
      "Edit(/Tests/**)",
      "Edit(/docs/**)",
      "Edit(/Resources/**)"
    ],
    "ask": [
      "Agent(model:opus)",
      "Edit(/scripts/**)",
      "Edit(/.claude/**)",
      "Edit(/Package.swift)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swift package *)",
      "Bash(xcodebuild *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}
